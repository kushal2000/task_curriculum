# Claude Code session files
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
.venv_*/
venv/
env/

# Training / experiment outputs
train_dir/
outputs/
wandb/
# Ignore the CONTENTS, not the directory: git cannot re-include a file whose parent directory is
# excluded, so `videos/` + `!videos/README.md` silently keeps the README untracked.
videos/*
!videos/README.md
evals/
runs/
experiments/runs/

# Downloaded artifacts
pretrained_policy/
pretrained_assembly/

# Baked URDF->USD cache: written under .venv_isaacsim, read by the kit-less Newton venv.
# Regenerate with `python -m isaacsimenvs.newton.usd_cache --populate`.
.usd_cache/

# Third-party source checkouts (Isaac Lab 3.0 for the Newton backend).
# Not a submodule by choice: the pinned SHA lives in scripts/install_isaaclab3.sh, so the
# checkout is reproducible without carrying submodule machinery in the repo.
third_party/

# Pytest
.pytest_cache/

# Large media. Renders live under videos/ (ignored above) and are reproducible from
# `isaacsimenvs/eval/render_newton.py`, so none of them belong in history.
*.mp4

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# SLURM job logs: large, regenerable, and one per run
slurm_logs/

# G1 + Wuji Hand 2 models, fetched at a pinned upstream SHA by scripts/g1_wuji/fetch_assets.sh.
# Also holds the URDF->USD conversions the Isaac Sim replayer writes under usd/.
assets/g1_wuji2_description/

# Flexiv Rizon 4s + Wuji Hand 2 models, fetched at pinned upstream SHAs by
# scripts/flexiv_wuji/fetch_assets.sh, plus the composed arm+hand URDF it writes.
assets/flexiv_wuji/

# Per-env probe dumps under docs/results. Every entry of these is one array element PER ENV, so a
# 1536-env probe is 3 MB of raw state while the numbers the write-ups quote are the scalar summary
# fields beside it (`rests_flat`, `stable`, `fold_solvable`, `timing`). Every other tracked file in
# docs/results is a few KB for this reason. Regenerate with
# `scripts/analysis/rigid_cloth_env_probe.py` via `scripts/cluster/bos14_rigid_cloth_probe.sh`
# (and the armature/spawn-height sweeps, which are the same probe over a parameter).
docs/results/rigid_cloth_env_probe_*.json
docs/results/rigid_cloth_arm_*.json
docs/results/rigid_cloth_spawn_*.json
