# Claude Code session files
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
.venv_*/
venv/
env/

# EVERY run artifact goes under debug_outputs/ (isaacsimenvs/utils/paths.py): train_logs/ (one folder per
# run, <month>/<date>_<name>_<job>/, with its checkpoints, config, wandb/ and Slurm log), videos/ and
# deployment/ (real-robot recordings and logs).
debug_outputs/
# The pre-2026-11-15 location, still present in older checkouts: move it to debug_outputs/train_logs/.
/outputs/

# Every tool cache, one subfolder per tool: usd/ (the baked URDF->USD cache the Newton envs read;
# written under .venv/isaacsim, regenerate with `python -m isaacsimenvs.newton.usd_cache --populate`),
# pytest/, ruff/ (pyproject.toml points both here).
.cache/

# third_party/ is NOT ignored: vendored upstream source, committed (third_party/VENDORED.md).

# Pre-restructure locations, still present in older checkouts: move run artifacts into
# debug_outputs/train_logs/ (wandb/ -> wandb/, slurm_logs/ -> slurm/), videos/ into
# debug_outputs/videos/, and caches into .cache/ (.usd_cache/ -> .cache/usd/).
/wandb/
/slurm_logs/
/videos/
/experiments/
/.usd_cache/
/.pytest_cache/
/.ruff_cache/
/train_dir/
/evals/
/runs/

# Deploy-time state on the robot PC: camera calibration captures and the fitted extrinsics.
deployment/calibration/captures/
deployment/calibration/compare/
deployment/calibration/extrinsics/

# Play priors, one folder per robot: pretrained_policy/{kuka_sharpa,flexiv_wuji}/{model.pth,config.yaml}
# (model.pth is ~400 MB, over GitHub's file limit).
/pretrained_policy
pretrained_assembly/

# Large media and local-only binaries: renders, policy zips, the Isaac Lab overlay image, prior
# checkpoints, pip cache.
*.mp4
/fabric_*.zip
/isaaclab_overlay.img
/checkpoints/
/isaac_cache/
/lift1.zip

# assets/urdf/flexiv_wuji/ (the Rizon 4s + Wuji Hand 2 models from scripts/flexiv_wuji/fetch_assets.sh
# and the composed URDFs) is committed in full: the training-time pose viewer loads the robot URDF
# and its meshes from raw.githubusercontent.com at the run's branch. Do not move it to LFS -- raw
# GitHub serves LFS files as pointer stubs.

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
