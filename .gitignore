# Claude Code session files
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
.venv_*/
venv/
env/

# Training / experiment outputs
train_dir/
outputs/
wandb/
videos/
evals/
runs/
experiments/runs/

# Downloaded artifacts
pretrained_policy/
pretrained_assembly/

# Baked URDF->USD cache: written under .venv_isaacsim, read by the kit-less Newton venv.
# Regenerate with `python -m isaacsimenvs.tasks.cloth.backends.vbd.newton_support.usd_cache --populate`.
.usd_cache/

# Third-party source checkouts (Isaac Lab 3.0 for the Newton backend).
# Not a submodule by choice: the pinned SHA lives in scripts/install_isaaclab3.sh, so the
# checkout is reproducible without carrying submodule machinery in the repo.
third_party/

# Pytest
.pytest_cache/

# Large media. Renders live under videos/ (ignored above) and are reproducible from
# `isaacsimenvs/eval/render_newton.py`, so none of them belong in history.
*.mp4

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# SLURM job logs: large, regenerable, and one per run
slurm_logs/

# Raw eval / probe output: kept local, never committed.
docs/results/

# Flexiv Rizon 4s + Wuji Hand 2 models, fetched at pinned upstream SHAs by
# scripts/flexiv_wuji/fetch_assets.sh, plus the composed arm+hand URDF it writes. Unlike
# g1_wuji2_description these ARE committed: the training-time pose viewer loads the robot URDF and
# its meshes from raw.githubusercontent.com at the run's branch. Only what the composed left-hand
# robot and the right-hand human-like robot reference is kept; the rest of the right hand is ignored. Do not move them to LFS -- raw GitHub
# serves LFS files as pointer stubs.
assets/flexiv_wuji/wuji_hand2/urdf/right*
assets/flexiv_wuji/wuji_hand2/mjcf/right*

# The right Wuji Hand's sysid fit (robots.FLEXIV_WUJI_RIGHT_REAL holds its values, rounded): kept local,
# it identifies the lab's hand. tests/test_robot_specs.py skips its check when the file is absent.
assets/flexiv_wuji/wuji_hand2_right_sysid_fit_*.json
