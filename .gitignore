# Claude Code session files
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/

# Virtual environments
.venv/
.venv_*/
venv/
env/

# EVERY run artifact goes under outputs/ (isaacsimenvs/utils/paths.py): Hydra run dirs
# outputs/<date>/<time>/, outputs/wandb/, outputs/slurm/ (scripts/slurm/submit.sh), outputs/results/
# (eval JSONs and probe dumps), outputs/videos/, outputs/deploy/ (robot recordings and logs).
outputs/

# Pre-restructure output locations, still present in older checkouts: move their contents into
# outputs/ (wandb/ -> outputs/wandb/, slurm_logs/ -> outputs/slurm/, videos/ -> outputs/videos/).
/wandb/
/slurm_logs/
/videos/
/experiments/
/train_dir/
/evals/
/runs/

# Deploy-time state on the robot PC: camera calibration captures and the fitted extrinsics.
deploy/calibration/captures/
deploy/calibration/compare/
deploy/calibration/extrinsics/

# Downloaded artifacts (on portal, pretrained_policy is a symlink to
# /share/portal/kk837/simtoolreal/pretrained_policy, hence no trailing slash).
/pretrained_policy
pretrained_assembly/

# Large media and local-only binaries: renders, policy zips, the Isaac Lab overlay image, prior
# checkpoints, pip cache.
*.mp4
/fabric_*.zip
/isaaclab_overlay.img
/checkpoints/
/isaac_cache/
/lift1.zip

# Baked URDF->USD cache: written under .venv_isaacsim, read by the kit-less Newton venv.
# Regenerate with `python -m isaacsimenvs.newton.usd_cache --populate`.
.usd_cache/

# Third-party source checkouts, fetched at pinned SHAs instead of being submodules:
# IsaacLab (scripts/install_isaaclab3.sh) and the robot drivers aioflexiv / aiowuji
# (scripts/fetch_deploy_deps.sh).
third_party/

# Flexiv Rizon 4s + Wuji Hand 2 models, fetched at pinned upstream SHAs by
# scripts/flexiv_wuji/fetch_assets.sh, plus the composed arm+hand URDFs it writes. These ARE
# committed: the training-time pose viewer loads the robot URDF and its meshes from
# raw.githubusercontent.com at the run's branch. The right hand's vendor URDF/MJCF stay local; the
# composed right-hand URDFs and the meshes they reference are committed. Do not move them to LFS --
# raw GitHub serves LFS files as pointer stubs.
assets/flexiv_wuji/wuji_hand2/urdf/right*
assets/flexiv_wuji/wuji_hand2/mjcf/right*

# The right Wuji Hand's sysid fit (robots.FLEXIV_WUJI_RIGHT_REAL holds its values, rounded): kept
# local, it identifies the lab's hand. tests/test_robot_specs.py skips its check when it is absent.
assets/flexiv_wuji/wuji_hand2_right_sysid_fit_*.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
