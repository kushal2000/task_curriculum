#!/usr/bin/env bash
# Run .venv/isaacsim_ct's Python inside the Isaac Sim 5.1 container (Engaging: the host glibc is
# too old for Isaac Sim's wheels -- see docs/installation/engaging/install_isaacsim.sh).
#
#   scripts/isaacsim_py -m isaacsimenvs.eval.episodes --headless --task Isaacsimenvs-FoldPoolPhysx-Direct-v0 ...
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command -v apptainer >/dev/null || module load apptainer   # not on PATH on GPU nodes
SIF="${ISAACSIM_SIF:-/orcd/scratch/orcd/011/hglin/containers/isaac-sim_5.1.0.sif}"
exec apptainer exec --nv --bind /orcd --pwd "$PWD" \
  --env OMNI_KIT_ACCEPT_EULA=YES --env ACCEPT_EULA=Y \
  "$SIF" "$ROOT/.venv/isaacsim_ct/bin/python" "$@"
