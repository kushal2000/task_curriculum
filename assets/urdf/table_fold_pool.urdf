<?xml version="1.0"?>
<!-- Stage-2 fold pool: table_narrow.urdf widened in x only, to 0.6 x 0.4 m. Height unchanged.
     The robot-side edge must stay at y = +0.2: the arm's home pose puts the elbow below the table
     top at y ~0.38 and the forearm crosses table height at y ~0.345, so a 0.7 m (y +-0.35) table
     pinned the arm and no policy could reach the sheet. The far side needs no more: with the reach
     shift a sheet reaches y = -0.171 at most. The price is on the robot side, where a corner of a
     large, yawed sheet overhangs the edge in ~18% of resets (by > 5 cm in ~5%). -->
<robot name="box">
  <link name="box">
    <visual>
      <material name="wood">
        <color rgba="0.82 0.56 0.35 1.0"/>
      </material>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.3"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="500"/>
      <friction value="1.0"/>
      <inertia ixx="1000.0" ixy="0.0" ixz="0.0" iyy="1000.0" iyz="0.0" izz="1000.0"/>
    </inertial>
  </link>
</robot>
